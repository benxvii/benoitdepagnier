<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcer HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteRule ^downloads/PortfolioApp\.zip$ /downloads/Portfolio-win.zip [R=301,L]
  RewriteRule ^index\.html$ - [L]
  # Ne réécrire que les vrais fichiers (images, assets). Les dossiers
  # physiques (ex. galerie photo) doivent aussi retomber sur index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule . /index.html [L]
</IfModule>
