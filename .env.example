# Dev sans copie locale des médias dans public/ (photos, ZIP…)
# VITE_MEDIA_BASE_URL=https://benoitdepagnier.ch

# Optionnel — script scripts/sync-media-to-infomaniak.sh (sinon mêmes vars en ligne de commande)
# Les secrets GitHub ne sont pas lisibles en local ; recopie les valeurs depuis Infomaniak / GitHub Settings.
# FTP_HOST=
# FTP_USER=
# FTP_PASSWORD=

# Cloudinary — https://cloudinary.com/console
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_FOLDER=benoit
VITE_MANIFEST_URL=https://res.cloudinary.com/<cloud>/raw/upload/benoit/_galleries.json

# Dev sans copie locale des médias Infomaniak (legacy, à retirer après migration Cloudinary)
# VITE_MEDIA_BASE_URL=https://benoitdepagnier.ch

# Secrets GitHub Actions pour scripts/sync-galleries.mjs (jamais côté client)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=benoit
